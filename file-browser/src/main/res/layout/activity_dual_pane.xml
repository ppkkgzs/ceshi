<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:titleTextColor="@color/white"
        app:title="@string/title_dual_pane" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左栏 -->
        <LinearLayout
            android:id="@+id/left_pane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#1AFFFFFF">

            <TextView
                android:id="@+id/left_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textColor="@color/path_text"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/left_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/left_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/empty_folder"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- 分割条拖动把手：左右拖动调整两栏宽度占比 -->
        <View
            android:id="@+id/divider"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="#2A000000"
            android:contentDescription="@string/divider_hint" />

        <!-- 中缝操作条 -->
        <LinearLayout
            android:id="@+id/mid_bar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="2dp"
            android:background="#0D000000">

            <Button
                android:id="@+id/copy_right_to_left"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="◀"
                android:contentDescription="@string/copy_to_left" />

            <Button
                android:id="@+id/copy_left_to_right"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="▶"
                android:contentDescription="@string/copy_to_right" />
        </LinearLayout>

        <!-- 右栏 -->
        <LinearLayout
            android:id="@+id/right_pane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#05FFFFFF">

            <TextView
                android:id="@+id/right_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textColor="@color/path_text"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/right_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/right_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/empty_folder"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 底栏：选择当前操作的栏（左/右）+ 上一页 / 下一页 / 添加 / 回到首页 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bottom_bar_bg"
        android:elevation="4dp">

        <Button
            android:id="@+id/tab_left"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_left" />

        <Button
            android:id="@+id/tab_right"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_right" />

        <Button
            android:id="@+id/dual_prev"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="◀"
            android:contentDescription="上一页" />

        <Button
            android:id="@+id/dual_next"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▶"
            android:contentDescription="下一页" />

        <Button
            android:id="@+id/dual_add"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="＋"
            android:contentDescription="添加" />

        <Button
            android:id="@+id/dual_home"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="↑"
            android:contentDescription="回到首页" />
    </LinearLayout>
</LinearLayout>