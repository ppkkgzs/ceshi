<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:titleTextColor="@color/white"
        app:title="@string/about_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/about_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="24sp"
                android:textStyle="bold"
                android:paddingTop="12dp" />

            <TextView
                android:id="@+id/about_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#80000000"
                android:paddingTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_desc"
                android:textSize="14sp"
                android:textColor="#66000000"
                android:paddingTop="8dp"
                android:paddingBottom="16dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_open_github"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_download" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_check_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_check_update"
                android:layout_marginTop="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_open_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="开源声明"
                android:layout_marginTop="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_signing_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="签名变更说明"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/update_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#1A73E8"
                android:paddingTop="12dp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>